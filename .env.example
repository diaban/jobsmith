# Copy to .env and fill in what you use:  cp .env.example .env
# Every entrypoint (jobsmith / python -m jobsmith) loads .env
# from the directory you run it in. .env is gitignored — never commit real keys.

# ---------------- OpenAI ----------------
# Example case: OpenAI key + gpt-5-nano (cheap/fast reasoning model).
# gpt-5* models are handled as reasoning models by OpenAILLMClient:
# `temperature` is dropped and the cap is sent as `max_completion_tokens`.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-nano

# Point at any OpenAI-compatible endpoint instead (Ollama, vLLM, gateway):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# ---------------- Persistence ----------------
# Where jobs and conversations live. Unset = a SQLite file in your user data
# dir ($XDG_DATA_HOME/jobsmith/jobs.db, else ~/.local/share/jobsmith/jobs.db on
# Linux), kept across runs. Deliverables go to reports/ next to it.
#   JOBSMITH_DB=memory                                      # keep nothing past the process
#   JOBSMITH_DB=agent.db                                    # another SQLite file
#   JOBSMITH_DB=postgresql://user:pass@localhost:5432/agent # Postgres -> .[postgres]
# JOBSMITH_REPORTS_DIR=artifacts                            # reports where you run from

# ---------------- Anthropic ----------------
# If ANTHROPIC_API_KEY is set, the REPL prefers Claude over OpenAI
# (force a provider with:  jobsmith --llm=openai chat)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-opus-5

# ---------------- Web search (document source) ----------------
# With a key, jobs gain a `web_search` step alongside `documents`; without one
# the capability is not registered at all.  Extra: .[web]
# TAVILY_API_KEY=tvly-your-key-here
