# Copy to .env and fill in what you use:  cp .env.example .env
# The chat REPL (python -m agent_oo.examples.banking.chat) loads .env from the
# directory you run it in. .env is gitignored — never commit real keys.

# ---------------- OpenAI ----------------
# Example case: OpenAI key + gpt-5-nano (cheap/fast reasoning model).
# gpt-5* models are handled as reasoning models by OpenAILLMClient:
# `temperature` is dropped and the cap is sent as `max_completion_tokens`.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-nano

# Point at any OpenAI-compatible endpoint instead (Ollama, vLLM, gateway):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# ---------------- Persistence ----------------
# Where jobs, artifacts and conversations live. Unset = in-memory: everything
# is lost when the process exits (only the .md reports remain on disk).
#   AGENT_OO_DB=agent.db                                    # SQLite   -> .[sqlite]
#   AGENT_OO_DB=postgresql://user:pass@localhost:5432/agent # Postgres -> .[postgres]
# AGENT_OO_DB=agent.db

# ---------------- Anthropic ----------------
# If ANTHROPIC_API_KEY is set, the REPL prefers Claude over OpenAI
# (force a provider with:  python -m agent_oo.examples.banking.chat --llm=openai)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-opus-5
